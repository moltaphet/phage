# Frontend environment variables (Vite inlines these at build time).
#
# Copy to `.env.local` and adjust. Every variable here is OPTIONAL — the frontend
# falls back to the verified studio-dev deployment in `src/lib/contract.ts`, so an
# empty file is a working configuration.

# Address of the deployed PhageSentinel contract on GenLayer Studio-dev (chain 61997).
# Set this to point the dApp at a different deployment without touching code.
VITE_PHAGE_CONTRACT_ADDRESS=0x86a3C3d3B35BD6eF5f0D947EB49a553b8200bd80

# The network itself (chain id 61997, RPC https://studio-dev.genlayer.com/api,
# explorer https://explorer-studio-dev.genlayer.com) is not environment-specific and
# lives in `src/lib/contract.ts` alongside the contract address.
