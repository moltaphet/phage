# Phage Sentinel — GenLayer deployment configuration.
#
# Network: GenLayer Studio-dev (chain 61997). Not to be confused with `studionet`
# (chain 61999), which is a different network with a different calldata encoding.

GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
GENLAYER_CHAIN_ID=61997
GENLAYER_EXPLORER_URL=https://explorer-studio-dev.genlayer.com

# The deployed PhageSentinel contract.
CONTRACT_ADDRESS=0x038d5Fd5082Cb05586C4C7CBcdDE827AC7f6BBa1

# `owner` as recorded on-chain — the address that deployed it.
# (The contract is fully permissionless and has no owner-only entrypoints; this is
# informational and matches the `owner` field of `get_registry_overview`.)
CONTRACT_OWNER=0x2E56C8579fA11CB144E6FD778dA772061f4dd930

# Same address under its older name. No code reads either variable today — the dApp
# resolves its address from `VITE_PHAGE_CONTRACT_ADDRESS` (see frontend/.env.example)
# and the test suites read `src/lib/contract.ts`. These exist for shell tooling and to
# keep a redeploy's parameters in one reviewable place.
DEPLOYER_ADDRESS=0x2E56C8579fA11CB144E6FD778dA772061f4dd930

# From `genlayer deploy` output (v0.4.0, 2026-09-22; consensus ACCEPTED).
DEPLOYMENT_TX_HASH=0x58e04a07337f3fb03076c5b42040bbe1d6a94e0b1c4908e90920c5f4540d632d
